{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':timezone(Europe/Berlin)',
  ],

  // Batch all update PRs into one weekly window instead of trickling in all week.
  // Security/vulnerability alerts bypass this schedule and are raised immediately.
  schedule: ['before 6am on monday'],

  // Re-resolve uv.lock weekly even when no range in pyproject.toml changes,
  // so CI keeps testing against current (transitive) dependency versions.
  lockFileMaintenance: {
    enabled: true,
  },

  packageRules: [
    // All non-major Python updates land as a single grouped PR.
    // Major updates (e.g. numpy 2 -> 3) stay as individual PRs.
    {
      matchManagers: ['pep621'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'python dependencies (non-major)',
    },
    // GitHub Actions minor/patch bumps: grouped and automerged once the
    // CI test matrix on the PR is green. Major bumps get their own PR.
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'github actions',
      automerge: true,
    },
  ],
}
