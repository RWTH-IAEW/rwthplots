# --- RWTH PPTX style ---------------------------------------------------------
# Figure geometry for PowerPoint (12 cm × 12 cm)
# 12 cm = 12 / 2.54 in = 4.7244094488 in
figure.figsize : 4.7244094488, 4.7244094488
figure.dpi     : 1500

# Colours (RWTH blue scale)
axes.prop_cycle : cycler('color', ['#00549F', '#F6A800', '#57AB27', '#CC071E', '#612158', '#A11035', '#7A6FAC', '#006165', '#BDCD00', '#0098A1', '#407FB7', '#FABE50', '#8DC060', '#D85C41', '#834E75', '#B65256', '#9B91C1', '#2D7F83', '#D0D95C', '#00B1B7', '#8EBAE5', '#FDD48F', '#B8D698', '#E69679', '#A8859E', '#CD8B87', '#BCB5D7', '#7DA4A7', '#E0E69A', '#89CCCF', '#C7DDF2', '#FEEAC9', '#DDEBCE', '#F3CDBB', '#D2C0CD', '#E5C5C0', '#DEDAEB', '#BFD0D1', '#F0F3D0', '#CAE7E7', '#E8F1FA', '#FFF7EA', '#F2F7EC', '#FAEBE3', '#EDE5EA', '#F5E8E5', '#F2F0F7', '#E6ECEC', '#F9FAED', '#EBF6F6'])

# Axes & titles
axes.titlesize   : 20
axes.titleweight : bold

# Grid
axes.grid        : True
axes.grid.axis   : both
axes.grid.which  : both
grid.linestyle   : --
grid.alpha       : 0.5

# Ticks (slightly larger for presentations)
xtick.labelsize  : 16
ytick.labelsize  : 16
xtick.direction  : out
ytick.direction  : out
xtick.major.size : 5.0
xtick.minor.size : 3.0
ytick.major.size : 5.0
ytick.minor.size : 3.0
xtick.minor.visible : True
ytick.minor.visible : True

# Lines & borders
lines.linewidth  : 1.0
axes.linewidth   : 0.5
grid.linewidth   : 0.5

# Legend
legend.frameon   : True
legend.fontsize  : 16

# Fonts
text.usetex      : True
font.family      : sans-serif
font.sans-serif  : Arial
font.size        : 16
text.color       : #404040

# LaTeX preamble – sans serif maths to match slides
# (Requires LaTeX packages helvet & sansmath on the system)
text.latex.preamble :
    \usepackage{amsmath}
    \usepackage{amssymb}
    \usepackage{helvet}
    \usepackage{sansmath}
    \sansmath

# Backgrounds
figure.facecolor : none      # transparent canvas (nice on PPT background)
axes.facecolor   : white     # white plotting area

# Saving
savefig.transparent : False  # keep axes background white
savefig.bbox        : tight
savefig.pad_inches  : 0.05
